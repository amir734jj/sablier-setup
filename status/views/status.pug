doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Container status
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous")
    style.
      @media (max-width: 767.98px) {
        .status-table thead {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
          border: 0;
        }
        .status-table, .status-table tbody, .status-table tr, .status-table th, .status-table td {
          display: block;
          width: 100%;
        }
        .status-table tbody tr {
          margin-bottom: 1rem;
        }
        .status-table tbody td {
          display: grid;
          grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
          gap: .5rem;
          overflow-wrap: anywhere;
        }
        .status-table tbody td::before {
          content: attr(data-label);
          font-weight: 600;
        }
      }
  body.bg-body-tertiary
    main.container.py-5
      h1.mb-3 Container status
      if message
        p.alert.alert-danger(role="alert")= message
      else
        p.text-body-secondary
          | Last checked: 
          time(datetime=status.checked_at title=formatTime(status.checked_at))= relativeTime(status.checked_at, status.checked_at)
        if status.groups.length
          .table-responsive
            table.table.table-striped.align-middle.status-table
              thead
                tr
                  th(scope="col") Group
                  th(scope="col") Status
                  th(scope="col") Container states
                  th(scope="col") Last started
                  th(scope="col") Last stopped
              tbody
                each group in status.groups
                  tr
                    th.text-break(scope="row")= group.group
                    td(data-label="Status")
                      span.badge(class=group.status === "running" ? "text-bg-success" : "text-bg-danger")= group.status.replaceAll("_", " ")
                    td.text-break(data-label="Container states")= Object.entries(group.states).map(([name, count]) => `${name}: ${count}`).join(", ")
                    each field, label in { "Last started": "last_started_at", "Last stopped": "last_stopped_at" }
                      td(data-label=label)
                        if group[field]
                          time(datetime=group[field] title=formatTime(group[field]))= relativeTime(group[field], status.checked_at)
                        else
                          span.text-body-secondary Not available
        else
          p.alert.alert-info No Sablier-enabled containers found.
        p
          a.btn.btn-outline-primary(href="") Refresh status
        footer.mt-4.text-body-secondary= status.note
        p.small.text-body-secondary Times show the most recent start and stop in each group, not last traffic. They reset when containers are replaced. A running container's last stop may belong to its previous run.
      section.mt-5(aria-labelledby="events-heading")
        h2#events-heading Sablier events
        p.small.text-body-secondary Recent recognized Sablier events for currently deployed, enabled containers. Only public group names and fixed explanations are shown, never raw logs or container identifiers.
        p#events-state(role="status" aria-live="polite") Loading diagnostics...
        ul#diagnostics.list-group.mb-3
        .table-responsive
          table.table.table-striped.align-middle.status-table
            thead
              tr
                th(scope="col") Time (UTC)
                th(scope="col") Group
                th(scope="col") Event
                th(scope="col") Explanation
            tbody#events
        noscript
          p.alert.alert-info Enable JavaScript to load live Sablier diagnostics.
      p.small.text-body-secondary Automatically refreshes every 30 seconds.
      p.small.text-body-secondary Events refresh every 5 seconds; up to 100 events from the past hour are shown. History is bounded by the latest 1,000 daemon log records and Docker log rotation, and may be incomplete.
    script.
      window.setTimeout(() => window.location.reload(), 30_000);
      window.addEventListener("pageshow", event => {
        if (event.persisted) window.location.reload();
      });
      async function refreshEvents() {
        const state = document.getElementById("events-state");
        try {
          const response = await fetch("/events", { cache: "no-store", signal: AbortSignal.timeout(4500) });
          if (!response.ok) throw new Error("Diagnostics request failed");
          const data = await response.json();
          const rows = data.events.map(event => {
            const row = document.createElement("tr");
            const values = {
              "Time (UTC)": new Date(event.timestamp).toISOString().replace("T", " ").replace("Z", " UTC"),
              "Group": event.group ?? "Sablier",
              "Event": event.type.replaceAll("_", " "),
              "Explanation": event.explanation,
            };
            for (const [label, value] of Object.entries(values)) {
              const cell = document.createElement("td");
              cell.dataset.label = label;
              cell.className = "text-break";
              cell.textContent = value;
              row.append(cell);
            }
            return row;
          });
          const diagnostics = data.diagnostics.map(item => {
            const entry = document.createElement("li");
            entry.className = `list-group-item ${item.severity === "error" ? "list-group-item-danger" : "list-group-item-warning"}`;
            entry.textContent = `${item.group ?? "Sablier"}: ${item.explanation} (${item.count} recent event${item.count === 1 ? "" : "s"})`;
            return entry;
          });
          document.getElementById("events").replaceChildren(...rows);
          document.getElementById("diagnostics").replaceChildren(...diagnostics);
          state.className = "small text-body-secondary";
          state.textContent = `${rows.length ? "Events checked" : "No recognized events in the available log window; checked"} at ${new Date(data.checked_at).toISOString()}. Summaries describe recent history, not current failures.${data.limited ? " History limit reached." : ""}${data.ignored_records ? ` ${data.ignored_records} unrecognized or unrelated records omitted.` : ""}`;
        } catch (error) {
          console.error("Unable to refresh Sablier diagnostics:", error);
          state.className = "alert alert-danger";
          state.textContent = "Sablier diagnostics are temporarily unavailable. Any events below are stale; container status is independent. Retrying in 5 seconds.";
        } finally {
          window.setTimeout(refreshEvents, 5_000);
        }
      }
      refreshEvents();
