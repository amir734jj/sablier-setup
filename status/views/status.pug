doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Container status
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous")
  body.bg-body-tertiary
    main.container.py-5
      h1.mb-3 Container status
      if message
        p.alert.alert-danger(role="alert")= message
      else
        p.text-body-secondary
          | Last checked: 
          time(datetime=status.checked_at)= status.checked_at
        if status.groups.length
          .table-responsive
            table.table.table-striped.align-middle
              thead
                tr
                  th(scope="col") Group
                  th(scope="col") Status
                  th(scope="col") Container states
              tbody
                each group in status.groups
                  tr
                    th.text-break(scope="row")= group.group
                    td
                      span.badge(class=group.status === "running" ? "text-bg-success" : "text-bg-danger")= group.status.replaceAll("_", " ")
                    td.text-break= Object.entries(group.states).map(([name, count]) => `${name}: ${count}`).join(", ")
        else
          p.alert.alert-info No Sablier-enabled containers found.
        p
          a.btn.btn-outline-primary(href="") Refresh status
        footer.mt-4.text-body-secondary= status.note
