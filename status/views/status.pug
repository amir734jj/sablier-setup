doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Container status
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous")
    style.
      @media (max-width: 767.98px) {
        .status-table thead {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
          border: 0;
        }
        .status-table, .status-table tbody, .status-table tr, .status-table th, .status-table td {
          display: block;
          width: 100%;
        }
        .status-table tbody tr {
          margin-bottom: 1rem;
        }
        .status-table tbody td {
          display: grid;
          grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
          gap: .5rem;
          overflow-wrap: anywhere;
        }
        .status-table tbody td::before {
          content: attr(data-label);
          font-weight: 600;
        }
      }
  body.bg-body-tertiary
    main.container.py-5
      h1.mb-3 Container status
      if message
        p.alert.alert-danger(role="alert")= message
      else
        p.text-body-secondary
          | Last checked: 
          time(datetime=status.checked_at title=formatTime(status.checked_at))= relativeTime(status.checked_at, status.checked_at)
        if status.groups.length
          .table-responsive
            table.table.table-striped.align-middle.status-table
              thead
                tr
                  th(scope="col") Group
                  th(scope="col") Status
                  th(scope="col") Container states
                  th(scope="col") Last started
                  th(scope="col") Last stopped
              tbody
                each group in status.groups
                  tr
                    th.text-break(scope="row")= group.group
                    td(data-label="Status")
                      span.badge(class=group.status === "running" ? "text-bg-success" : "text-bg-danger")= group.status.replaceAll("_", " ")
                    td.text-break(data-label="Container states")= Object.entries(group.states).map(([name, count]) => `${name}: ${count}`).join(", ")
                    each field, label in { "Last started": "last_started_at", "Last stopped": "last_stopped_at" }
                      td(data-label=label)
                        if group[field]
                          time(datetime=group[field] title=formatTime(group[field]))= relativeTime(group[field], status.checked_at)
                        else
                          span.text-body-secondary Not available
        else
          p.alert.alert-info No Sablier-enabled containers found.
        p
          a.btn.btn-outline-primary(href="") Refresh status
        footer.mt-4.text-body-secondary= status.note
        p.small.text-body-secondary Times show the most recent start and stop in each group, not last traffic. They reset when containers are replaced. A running container's last stop may belong to its previous run.
      p.small.text-body-secondary Automatically refreshes every 30 seconds.
    script.
      window.setTimeout(() => window.location.reload(), 30_000);
      window.addEventListener("pageshow", event => {
        if (event.persisted) window.location.reload();
      });
